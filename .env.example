# Meritloom environment variables
#
# Copy this file to .env.local and fill in the values from your Supabase
# project dashboard (Project Settings -> API).
#
# Only the public anon key belongs here. NEVER put the service-role key in
# any environment file used by the app — it would end up in the client bundle.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
